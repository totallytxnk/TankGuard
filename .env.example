# Discord Bot Token (required)
DISCORD_TOKEN=your-bot-token-here

# Redis connection string (required for rate limiting)
# Examples:
#   redis://localhost:6379
#   redis://:password@hostname:6379/0
#   rediss://... (TLS)
REDIS_URL=redis://localhost:6379

# Rate limiter configuration (Token Bucket / fixed-window hybrid)
# Maximum messages allowed inside the window
RATE_LIMIT_MAX=5

# Window size in milliseconds (3 seconds)
RATE_LIMIT_WINDOW_MS=3000

# Discord channel ID for moderation action embeds (optional)
# Leave empty to disable Discord logging
LOG_CHANNEL_ID=1535324551674732586
